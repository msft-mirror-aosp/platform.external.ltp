 		if (vec[n] & 1)
 			act_pages++;
 	}
 
-	return act_pages;
+	return nr_kernel_pgs_to_nr_pgs(act_pages);
 }
 
 static void verify_mlock2(unsigned int n)
@@ -137,6 +139,7 @@ end2:
 static void setup(void)
 {
 	pgsz = getpagesize();
+	MLOCK_PAGE_SIZE_EMULATION_OFFSET(tcases);
 }
 
