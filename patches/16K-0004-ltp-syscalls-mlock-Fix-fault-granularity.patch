 static struct tcase {
 	size_t populate_pages;
 	size_t lock_pages;
-	size_t offset;
+	ssize_t offset; /* Can be negative */
 	size_t exp_vmlcks;
 	size_t exp_present_pages;
 	int flag;
@@ -78,12 +80,12 @@ static size_t check_locked_pages(char *addr, size_t len, size_t num_pgs)
 
 	SAFE_MINCORE(addr, len, vec);
 
-	for (n = 0; n < num_pgs; n++) {
