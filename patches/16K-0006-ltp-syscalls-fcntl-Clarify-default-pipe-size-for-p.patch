+	 * pages in the kernel.
+	 */
+	test_max_priv = kernel_page_size() * PIPE_DEF_BUFFERS;
 
 	if (!access("/proc/sys/fs/pipe-max-size", F_OK)) {
 		SAFE_FILE_SCANF("/proc/sys/fs/pipe-max-size", "%d",
