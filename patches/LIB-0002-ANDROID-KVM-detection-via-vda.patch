ANDROID: KVM detection via vda check

Detect KVM environment by checking for the presence of /dev/vda,
/dev/block/vda, or /sys/block/vda which are common virtual block devices
in Android emulator/KVM environments.

Test: mm

diff --git a/lib/tst_virt.c b/lib/tst_virt.c
index 109d7a853..1f8fc2d64 100644
--- a/lib/tst_virt.c
+++ b/lib/tst_virt.c
@@ -23,9 +23,20 @@
  */
 
 #include <unistd.h>
+#include <sys/stat.h>
 #include "test.h"
 #include "tso_safe_macros.h"
 
+static int file_exist(const char *path)
+{
+       struct stat st;
+
+       if (!access(path, R_OK) && !stat(path, &st))
+               return 1;
+
+       return 0;
+}
+
 static int is_kvm(void)
 {
        FILE *cpuinfo;
@@ -44,6 +55,11 @@ static int is_kvm(void)
        }
 
        SAFE_FCLOSE(NULL, cpuinfo);
+
+       if (file_exist("/dev/vda") || file_exist("/dev/block/vda")
+                       || file_exist("/sys/block/vda"))
+               found = 1;
+
        return found;
 }
